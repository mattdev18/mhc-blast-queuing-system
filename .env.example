# ==============================================================================
# May Harvest Corporation - Product Queuing & Blast Freezing System
# ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# IMPORTANT:
# - This file contains secret keys. It is IGNORED by git via .gitignore.
# - Never commit your real API token or credentials to GitHub!
# - When deploying on Render, add these variables in your Render Dashboard:
#   (Render Dashboard > Service > Environment > Add Environment Variable)
# ==============================================================================

# Server Port (Render sets this automatically, default is 3000 locally or 10000 on Render)
PORT=3000

# Turso Cloud Database URL
# Example: libsql://your-db-name-your-org.turso.io
# If left empty or omitted, system automatically falls back to local SQLite (file:mhc_blast_local.db)
TURSO_DATABASE_URL=

# Turso Cloud Auth Token (Generated via `turso db tokens create <db-name>` or Turso Web Console)
TURSO_AUTH_TOKEN=

# Node Environment
NODE_ENV=production
